# Copy to .env. Never put model API keys in the iOS app or commit this file with keys.
OPENAI_API_KEY=
# Include the version prefix. Compatible providers can use their own HTTPS base URL.
OPENAI_BASE_URL=https://api.openai.com/v1
# responses or chat_completions; the latter uses /chat/completions + JSON Schema.
OPENAI_API=responses
# Optional for reasoning models; gpt-5.4-mini supports none for low-latency replies.
OPENAI_REASONING_EFFORT=
TYPESAFE_API_KEY=
# typesafe uses TYPESAFE_API_KEY + TYPESAFE_BASE_URL; shared explicitly reuses OPENAI_BASE_URL + OPENAI_API_KEY.
# The shared provider must implement /v1/systemone and offer the selected Jev model.
JEV_PROVIDER=typesafe
TYPESAFE_BASE_URL=https://api.typesafe.ai
OPENAI_MODEL=gpt-4.1-mini
JEV_MODEL=jev-latest
# jev (assess + generate + select) or reply_only (GPT recommendation, no intimacy score).
ANALYSIS_MODE=jev
# Optional when this Mac needs a network proxy to reach the model service.
HTTPS_PROXY=
HTTP_PROXY=
NO_PROXY=localhost,127.0.0.1,::1
# Generate a random value: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Enter the same value in the iOS app's service access token field.
APP_ACCESS_TOKEN=
HOST=127.0.0.1
PORT=8787
# Explicit fixture mode only. Results are visibly marked as demo in the keyboard.
DEMO_MODE=0
