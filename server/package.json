{
  "name": "lianaiba-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.ts",
    "dev": "node --env-file-if-exists=.env --watch src/index.ts",
    "test": "node --test test/*.test.ts",
    "check:openai": "node --env-file-if-exists=.env scripts/check-openai.ts",
    "check:draft": "node --env-file-if-exists=.env scripts/check-draft.ts",
    "check:recommendation": "node --env-file-if-exists=.env scripts/check-recommendation.ts",
    "check:persona": "node --env-file-if-exists=.env scripts/check-recommendation.ts --persona",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "0.6.0",
    "undici": "^7.30.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  }
}
